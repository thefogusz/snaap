# Local: copy to .env. Never put real credentials in chat or Git.
APP_ORIGIN=http://127.0.0.1:4173
# npm run dev creates local PostgreSQL automatically; npm start requires DATABASE_URL.
DATABASE_URL=
# Production: set this to a directory on a persistent volume.
ASSET_STORAGE_PATH=.local/assets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Setup guide: docs/google-auth-setup.md
AI_API_KEY=
# Optional OpenAI-compatible endpoint, e.g. https://openrouter.ai/api/v1
AI_BASE_URL=
AI_STANDARD_MODEL=gpt-5-mini
AI_DEEP_MODEL=gpt-5.4
# Includes reasoning and visible output. The cost bound reserves this full limit.
AI_STANDARD_MAX_OUTPUT_TOKENS=6000
AI_DEEP_MAX_OUTPUT_TOKENS=6000
# Standard API prices in USD per 1M tokens, checked 2026-10-04.
# Recheck these rates whenever changing the model.
# https://developers.openai.com/api/docs/models/gpt-5-mini
AI_STANDARD_INPUT_USD_PER_MILLION=0.25
AI_STANDARD_OUTPUT_USD_PER_MILLION=2.00
# https://developers.openai.com/api/docs/models/gpt-5.4
AI_DEEP_INPUT_USD_PER_MILLION=2.50
AI_DEEP_OUTPUT_USD_PER_MILLION=15.00
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_LIVE_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# dev defaults to polling (no public URL); production defaults to webhook.
TELEGRAM_RECEIVE_MODE=
LINE_CHANNEL_SECRET=
LINE_ACCESS_TOKEN=
LINE_OA_URL=
# SNAAP LINE limits are configured in Admin > Usage limits. Provider quotas still apply.
# Generate a random 32-byte hex key and back it up separately; required for private exchange keys.
DATA_ENCRYPTION_KEY=
# Comma-separated exact hostnames, operator reviewed. Never localhost or private networks.
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_SIGNING_SECRET=
# Admin entry: /admin. The sole allowed Google identity is enforced in src/admin-access.ts.
